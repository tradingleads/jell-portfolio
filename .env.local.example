# Option A — OpenAI (default)
OPENAI_API_KEY=sk-...

# Option B — Groq (faster, generous free tier)
GROQ_API_KEY=gsk_...

# Set to "groq" to use Groq instead of OpenAI
AI_PROVIDER=openai

# ── Booking calendar (Google Calendar) ─────────────────────────────
# Powers app/api/book and app/api/availability. See README setup notes.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxx
# The calendar to book into — usually your Gmail address, or "primary"
GOOGLE_CALENDAR_ID=jellurmeneta64@gmail.com
