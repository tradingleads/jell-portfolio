# Option A — OpenAI (default)
OPENAI_API_KEY=sk-...

# Option B — Groq (faster, generous free tier)
GROQ_API_KEY=gsk_...

# Set to "groq" to use Groq instead of OpenAI
AI_PROVIDER=openai

# ── Booking calendar (Google Calendar) ─────────────────────────────
# Powers app/api/book and app/api/availability. See README setup notes.
# The refresh token must be authorized with BOTH scopes below (re-run the
# OAuth consent flow if it was only granted the calendar scope):
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxx
# The calendar to book into — usually your Gmail address, or "primary"
GOOGLE_CALENDAR_ID=jellurmeneta64@gmail.com
# Optional — where the "new booking" host notification email is sent.
# Defaults to GOOGLE_CALENDAR_ID if omitted (only works if that's a real address, not "primary").
HOST_NOTIFICATION_EMAIL=jellurmeneta64@gmail.com
